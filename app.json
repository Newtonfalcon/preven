{
  "expo": {
    "name": "preven",
    "slug": "preven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "preven",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.netech.preven",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.netech.preven",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyYOUR_ACTUAL_API_KEY_HERE",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "preven.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "preven",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "preven.appspot.com",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "123456789012",
      "EXPO_PUBLIC_FIREBASE_APP_APP_ID": "1:123456789012:web:abcdef123456789",
      "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "218680283243-q6af14mk3hjj092c8e8lqbeigqu27kj1.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "1323f06f-a3ee-4fb0-9423-06f0f0dc580b"
      }
    },
    "owner": "oyaghanewtons-team"
  }
}
